# Ubuntu 23.10+ blocks unprivileged user namespaces unless a profile allows
# them. WebKitGTK needs one to sandbox its web process (via bubblewrap), so
# this profile grants exactly that, like Ubuntu's own profile for Epiphany.
# It allows everything else and only exists to give Meridian a named label.

abi <abi/4.0>,
include <tunables/global>

profile meridian-calendar /usr/bin/meridian-calendar flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/meridian-calendar>
}
